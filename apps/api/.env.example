# Скопируйте файл в apps/api/.env для локального запуска или перенесите значения в секреты
# окружения. Реальные пароли, токены и ключи нельзя хранить в Git.

# --- Обязательные настройки API ---

NODE_ENV=production
PORT=3002

# Строка подключения к общей PostgreSQL. Перед стартом контейнер выполняет миграции dbmate.
DATABASE_URL=postgresql://portal:<пароль>@postgres:5432/portal

# Секрет подписи пользовательских JWT-сессий. Задайте длинное случайное значение.
JWT_SECRET=

# Ключи защиты данных авторизации. AUTH_ENCRYPTION_KEY — 32 байта в base64.
AUTH_HMAC_KEY=
AUTH_ENCRYPTION_KEY=

# Публичные адреса текущего контура без завершающего слеша.
WEB_APP_URL=https://portal.example.ru
WEB_BASE_URL=https://portal.example.ru
API_PUBLIC_URL=https://api.example.ru

# Список разрешённых origin через запятую. Если пусто, используется WEB_APP_URL.
CORS_ALLOWED_ORIGINS=https://portal.example.ru

# Домен cookie. Для localhost можно оставить пустым.
COOKIE_DOMAIN=.example.ru

# 1 — закрыть все пользовательские маршруты, кроме health и авторизации.
# PORTAL_PUBLIC — устаревающий совместимый переключатель; для нового деплоя используйте CLOSED_DEV.
CLOSED_DEV=1

# --- Сервисные секреты ---

# Legacy agent bearer используется только старым enrollment surface.
AGENT_JWT_SECRET=
# Серверный Ed25519 private JWK не передаётся агенту; публичный bounded key set возвращается при CSR enrollment.
COMMAND_TOKEN_SIGNING_KID=
COMMAND_TOKEN_SIGNING_PRIVATE_JWK=
COMMAND_VERIFICATION_KEYS=
GATEWAY_CA_CERTIFICATE_PEM=
GATEWAY_CA_PRIVATE_KEY_PEM=
# Optional JSON array of PEM certificates; defaults to GATEWAY_CA_CERTIFICATE_PEM.
GATEWAY_CA_BUNDLE_PEM=

# Общий секрет API и apps/relay для /internal/relay/v1/*. Длина: 32–512 символов.
RELAY_SERVICE_TOKEN=

# Общий секрет API и отдельного giga-assistant-worker для /internal/assistant/v1/*.
# Одно и то же случайное значение длиной 32–512 символов задаётся в обоих Vault paths.
ASSISTANT_SERVICE_TOKEN=

RELAY_INTERNAL_BASE_URL=http://127.0.0.1:9092
# Секреты курсоров. В production должны быть заданы явно.
PRINTER_CATALOG_CURSOR_SECRET=
PROJECT_CURSOR_SECRET=

# --- Первичный администратор ---

# Логин и пароль задаются вместе. UUID хранится в singleton marker.
# Изменение ADMIN_PASSWORD при startup ротирует credential и инвалидирует sessions.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Дополнительные username через запятую.
ADMIN_USERNAMES=
AGENT_ACCOUNTS_BETA_USERNAMES=

# --- S3-совместимое хранилище ---

S3_ENDPOINT=https://s3.example.ru
S3_REGION=ru-central-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_AUTH=auth
S3_BUCKET_MODELS=3mf
S3_BUCKET_GENERATIONS=generations
S3_BUCKET_PRINTERS_RESEARCH=printers-research

# Опциональная прямая раздача публичных файлов. Оба значения задаются вместе.
# S3_PUBLIC_URL_STYLE: vhost или global. Пусто — API проксирует файлы самостоятельно.
S3_PUBLIC_ENDPOINT=
S3_PUBLIC_URL_STYLE=

# --- Внутренние HTTP-сервисы ---

MESH_HTTP_URL=http://mesh:3101
GIGA_HTTP_URL=http://giga:3102

# OpenAI-совместимый endpoint эмбеддингов для поиска. Пусто — поиск по эмбеддингам недоступен.
HYPERPC_URL=

# Каталог bare Git-репозиториев. Каталог должен быть постоянным volume с правами пользователя node.
GIT_REPOS_DIR=/srv/git/repos

# --- Авторизация и почта ---

# Интеграция PlagID. Без секрета callback внешнего провайдера не принимается.
PLAGID_EXTERNAL_TOKEN_SECRET=
PLAGID_CALLBACK_URL=https://api.example.ru/auth/plagid/callback

# Почта. Если SMTP не настроен, отправка писем отключена с предупреждением в логе.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Только для локального non-production: 1 включает /auth/dev. В production всегда оставлять 0.
AUTH_DEV_BYPASS=0

# --- Веб-пуш ---

# Сгенерируйте один раз командой `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.ru

# --- Платежи ---

# Без реквизитов ЮKassa создание платежа возвращает 503.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# 2000 = комиссия платформы 20%; холд указан в днях.
BILLING_TAKE_RATE_BPS=2000
BILLING_HOLD_DAYS=14

# --- Опциональные продуктовые лимиты ---

GENERATION_QUOTA_HOURLY=10
GENERATION_QUOTA_DAILY=30
CONCEPT_GENERATION_QUOTA_HOURLY=240
CONCEPT_GENERATION_QUOTA_DAILY=1000
GENERATION_STALE_TIMEOUT_MINUTES=15
# Дополнительные запрещённые слова через запятую. Это не секрет.
GENERATION_BLOCKED_WORDS=

ASSISTANT_MESSAGE_QUOTA_HOURLY=30
ASSISTANT_MESSAGE_QUOTA_DAILY=150
ASSISTANT_THREAD_CREATE_QUOTA_DAILY=20
ASSISTANT_GLOBAL_QUEUED_RUNS_LIMIT=50
ASSISTANT_SSE_USER_CONCURRENT_LIMIT=4
ASSISTANT_SSE_IP_CONCURRENT_LIMIT=40
ASSISTANT_SSE_INSTANCE_CONCURRENT_LIMIT=500
ASSISTANT_RUN_ETA_SECONDS_PER_JOB=20
ASSISTANT_RUN_STALE_TIMEOUT_MINUTES=15

# Порог числа жалоб, после которого публикация Make скрывается. Пусто — дефолт из кода.
MAKE_REPORT_HIDE_THRESHOLD=

# Интервал отдельного процесса feed-score-worker; основной API его не запускает.
FEED_SCORE_BATCH_INTERVAL_MS=300000

# Списки исключений rate limit через запятую. Оставьте пустыми, если исключения не нужны.
RATE_LIMIT_ALLOWLIST_USER_IDS=
RATE_LIMIT_ALLOWLIST_IPS=

# Тонкая настройка многофакторных лимитов в минуту. Суффиксы означают пользователя,
# IP-адрес и отпечаток клиента; для public API вместо пользователя используется API-ключ.
# Значения ниже совпадают с дефолтами кода, поэтому менять их для обычного деплоя не требуется.
RATE_LIMIT_AUTH_PASSWORD_USERNAME_PER_MIN=5
RATE_LIMIT_AUTH_PASSWORD_IP_PER_MIN=10
RATE_LIMIT_AUTH_PASSWORD_FINGERPRINT_PER_MIN=10
RATE_LIMIT_ASSISTANT_MESSAGE_USER_PER_MIN=3
RATE_LIMIT_ASSISTANT_MESSAGE_IP_PER_MIN=12
RATE_LIMIT_ASSISTANT_MESSAGE_FINGERPRINT_PER_MIN=8
RATE_LIMIT_ASSISTANT_MESSAGE_REPLAY_USER_PER_MIN=30
RATE_LIMIT_ASSISTANT_MESSAGE_REPLAY_IP_PER_MIN=80
RATE_LIMIT_ASSISTANT_MESSAGE_REPLAY_FINGERPRINT_PER_MIN=50
RATE_LIMIT_ASSISTANT_THREAD_CREATE_USER_PER_MIN=5
RATE_LIMIT_ASSISTANT_THREAD_CREATE_IP_PER_MIN=15
RATE_LIMIT_ASSISTANT_THREAD_CREATE_FINGERPRINT_PER_MIN=10
RATE_LIMIT_ASSISTANT_STREAM_OPEN_USER_PER_MIN=30
RATE_LIMIT_ASSISTANT_STREAM_OPEN_IP_PER_MIN=100
RATE_LIMIT_ASSISTANT_STREAM_OPEN_FINGERPRINT_PER_MIN=60
RATE_LIMIT_DOWNLOAD_USER_PER_MIN=20
RATE_LIMIT_DOWNLOAD_IP_PER_MIN=40
RATE_LIMIT_DOWNLOAD_FINGERPRINT_PER_MIN=30
RATE_LIMIT_LISTING_USER_PER_MIN=120
RATE_LIMIT_LISTING_IP_PER_MIN=240
RATE_LIMIT_LISTING_FINGERPRINT_PER_MIN=180
RATE_LIMIT_MAKE_CREATE_USER_PER_MIN=5
RATE_LIMIT_MAKE_CREATE_IP_PER_MIN=10
RATE_LIMIT_MAKE_CREATE_FINGERPRINT_PER_MIN=8
RATE_LIMIT_MAKE_REPORT_USER_PER_MIN=5
RATE_LIMIT_MAKE_REPORT_IP_PER_MIN=10
RATE_LIMIT_MAKE_REPORT_FINGERPRINT_PER_MIN=8
RATE_LIMIT_MAKE_IMAGE_USER_PER_MIN=90
RATE_LIMIT_MAKE_IMAGE_IP_PER_MIN=120
RATE_LIMIT_MAKE_IMAGE_FINGERPRINT_PER_MIN=90
RATE_LIMIT_MODEL_REPORT_USER_PER_MIN=5
RATE_LIMIT_MODEL_REPORT_IP_PER_MIN=10
RATE_LIMIT_MODEL_REPORT_FINGERPRINT_PER_MIN=8
RATE_LIMIT_PUBLIC_API_KEY_PER_MIN=60
RATE_LIMIT_PUBLIC_API_IP_PER_MIN=240
RATE_LIMIT_PUBLIC_API_FINGERPRINT_PER_MIN=240
RATE_LIMIT_IDEA_CREATE_USER_PER_MIN=5
RATE_LIMIT_IDEA_CREATE_IP_PER_MIN=10
RATE_LIMIT_IDEA_CREATE_FINGERPRINT_PER_MIN=8
RATE_LIMIT_IDEA_ENRICH_USER_PER_MIN=5
RATE_LIMIT_IDEA_ENRICH_IP_PER_MIN=10
RATE_LIMIT_IDEA_ENRICH_FINGERPRINT_PER_MIN=8
RATE_LIMIT_PROMPT_VARIANTS_USER_PER_MIN=15
RATE_LIMIT_PROMPT_VARIANTS_IP_PER_MIN=30
RATE_LIMIT_PROMPT_VARIANTS_FINGERPRINT_PER_MIN=20
RATE_LIMIT_SLICE_CREATE_USER_PER_MIN=6
RATE_LIMIT_SLICE_CREATE_IP_PER_MIN=12
RATE_LIMIT_SLICE_CREATE_FINGERPRINT_PER_MIN=10
RATE_LIMIT_PROFILE_RECOMMENDATION_USER_PER_MIN=12
RATE_LIMIT_PROFILE_RECOMMENDATION_IP_PER_MIN=24
RATE_LIMIT_PROFILE_RECOMMENDATION_FINGERPRINT_PER_MIN=18
RATE_LIMIT_CALIBRATION_CREATE_USER_PER_MIN=5
RATE_LIMIT_CALIBRATION_CREATE_IP_PER_MIN=10
RATE_LIMIT_CALIBRATION_CREATE_FINGERPRINT_PER_MIN=8
RATE_LIMIT_CANDIDATE_SUGGEST_USER_PER_MIN=5
RATE_LIMIT_CANDIDATE_SUGGEST_IP_PER_MIN=10
RATE_LIMIT_CANDIDATE_SUGGEST_FINGERPRINT_PER_MIN=8
RATE_LIMIT_PRINT_REQUEST_CREATE_USER_PER_MIN=5
RATE_LIMIT_PRINT_REQUEST_CREATE_IP_PER_MIN=10
RATE_LIMIT_PRINT_REQUEST_CREATE_FINGERPRINT_PER_MIN=8
RATE_LIMIT_DEVICE_PRINT_REQUEST_CREATE_USER_PER_MIN=5
RATE_LIMIT_DEVICE_PRINT_REQUEST_CREATE_IP_PER_MIN=10
RATE_LIMIT_DEVICE_PRINT_REQUEST_CREATE_FINGERPRINT_PER_MIN=8
RATE_LIMIT_FEED_VOTE_USER_PER_MIN=60
RATE_LIMIT_FEED_VOTE_IP_PER_MIN=120
RATE_LIMIT_FEED_VOTE_FINGERPRINT_PER_MIN=90
RATE_LIMIT_FEED_POST_CREATE_USER_PER_MIN=5
RATE_LIMIT_FEED_POST_CREATE_IP_PER_MIN=10
RATE_LIMIT_FEED_POST_CREATE_FINGERPRINT_PER_MIN=8
RATE_LIMIT_FEED_COMMENT_CREATE_USER_PER_MIN=20
RATE_LIMIT_FEED_COMMENT_CREATE_IP_PER_MIN=40
RATE_LIMIT_FEED_COMMENT_CREATE_FINGERPRINT_PER_MIN=30
RATE_LIMIT_FEED_MEDIA_UPLOAD_USER_PER_MIN=15
RATE_LIMIT_FEED_MEDIA_UPLOAD_IP_PER_MIN=30
RATE_LIMIT_FEED_MEDIA_UPLOAD_FINGERPRINT_PER_MIN=20
RATE_LIMIT_FEED_GITVERSE_PARSE_USER_PER_MIN=20
RATE_LIMIT_FEED_GITVERSE_PARSE_IP_PER_MIN=40
RATE_LIMIT_FEED_GITVERSE_PARSE_FINGERPRINT_PER_MIN=30

# Настройки рекомендательной ленты; указаны текущие дефолты.
FEED_GATE_MIN_AGE_FOR_FULL_TRUST_DAYS=7
FEED_GATE_NEW_COMMUNITY_WINDOW_DAYS=14
FEED_GATE_MIN_ACCOUNT_AGE_DAYS=3
FEED_GATE_MIN_REPUTATION=1
FEED_RECOMMEND_SUBSCRIPTION_BOOST=0.5
FEED_RECOMMEND_TAG_BOOST=0.3
FEED_RECOMMEND_COLD_FRESHNESS_BOOST=0.4
FEED_RECOMMEND_INTEREST_WINDOW_DAYS=30
FEED_RECOMMEND_COLD_COMMUNITY_WINDOW_DAYS=30
FEED_RECOMMEND_COLD_COMMUNITY_POST_THRESHOLD=20
FEED_RECOMMEND_COLD_COMMUNITY_FRESH_HOURS=48

# Только для ручного provisioning-скрипта researcher, основной API переменную не читает.
# Формат: mf_research_<16-byte-public-id>.<32-byte-secret>; оба canonical base64url из CSPRNG.
RESEARCHER_API_KEY=
