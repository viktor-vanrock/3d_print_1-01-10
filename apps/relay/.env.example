# Скопируйте файл в apps/relay/.env или перенесите значения в секреты оркестратора.
# Relay принимает подключения устройств по WSS/mTLS и обращается к внутреннему API.

NODE_ENV=production

# Обязательно: тот же секрет 32–512 символов, который задан в apps/api.
RELAY_SERVICE_TOKEN=

# Обязательно: базовый адрес API. В production допустим только HTTPS.
RELAY_API_BASE_URL=https://api.example.ru

# Обязательно: PEM-файлы сертификата сервера, приватного ключа и доверенного CA устройств.
# Файлы нужно смонтировать в контейнер только для чтения.
RELAY_TLS_CERT_FILE=/run/secrets/relay/tls.crt
RELAY_TLS_KEY_FILE=/run/secrets/relay/tls.key
RELAY_TLS_CA_FILE=/run/secrets/relay/ca.crt

# Версия протокола и уникальный id экземпляра. Пустой id генерируется при каждом старте.
RELAY_PROTOCOL_VERSION=v1
RELAY_INSTANCE_ID=

# WSS-шлюз для устройств. Порт публикуется наружу через L4-прокси.
RELAY_GATEWAY_HOST=0.0.0.0
RELAY_GATEWAY_PORT=8443

# Health/ready/metrics. Не публикуйте этот listener в интернет.
RELAY_OBSERVABILITY_HOST=127.0.0.1
RELAY_OBSERVABILITY_PORT=9091

# API → Relay control-plane. Keep it internal; it must not share the observability port.
RELAY_INTERNAL_LISTEN_HOST=127.0.0.1
RELAY_INTERNAL_LISTEN_PORT=9092

# Таймауты и повторы запросов relay → API.
RELAY_API_TIMEOUT_MS=1000
RELAY_API_RETRY_ATTEMPTS=2
RELAY_API_RETRY_BASE_DELAY_MS=50

# Лимиты соединений и входящих кадров; указаны текущие дефолты.
RELAY_MAX_FRAME_BYTES=1048576
RELAY_MAX_SESSIONS=10000
RELAY_MAX_INFLIGHT_FRAMES=1024
RELAY_MAX_INFLIGHT_FRAMES_PER_SESSION=4
RELAY_MAX_FRAMES_PER_SECOND=60
RELAY_MAX_BUFFERED_BYTES=67108864
RELAY_MAX_BUFFERED_BYTES_PER_SESSION=4194304

# Служебные интервалы и корректное завершение процесса.
RELAY_HELLO_TIMEOUT_MS=10000
RELAY_HEARTBEAT_SWEEP_MS=1000
RELAY_REVALIDATION_INTERVAL_MS=2000
RELAY_REVALIDATION_TIMEOUT_MS=1000
RELAY_REVALIDATION_FAIL_CLOSED_MS=5000
RELAY_SHUTDOWN_DRAIN_MS=10000

# RELAY_INTERNAL_TOKEN, RELAY_API_TOKEN и API_INTERNAL_URL устарели и запрещены.
