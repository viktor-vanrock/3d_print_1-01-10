{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://3mf.tech/schemas/pilot-passport.schema.json",
  "title": "Moonraker pilot passport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pilot_id", "model", "connector", "required_capabilities", "safe_commands", "telemetry", "config", "rollback", "pilot_status"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "pilot_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brand", "name", "firmware_class"],
      "properties": {
        "brand": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "firmware_class": { "const": "klipper" }
      }
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "api", "version_probe"],
      "properties": {
        "type": { "const": "moonraker" },
        "api": { "const": "https://moonraker.readthedocs.io/en/latest/web_api/" },
        "version_probe": { "$ref": "#/$defs/probe" }
      }
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" }
    },
    "safe_commands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/command" }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subscription", "fields"],
      "properties": {
        "subscription": { "$ref": "#/$defs/probe" },
        "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/telemetry_field" } }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "fingerprint_inputs"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "fingerprint_inputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["point", "operator_action", "verification"],
      "properties": {
        "point": { "type": "string", "minLength": 1 },
        "operator_action": { "type": "string", "minLength": 1 },
        "verification": { "$ref": "#/$defs/probe" }
      }
    },
    "pilot_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "updated_at", "fresh_for_hours", "source", "trust_limit"],
      "properties": {
        "stage": { "enum": ["not_started", "building", "burn_in", "ready", "stopped"] },
        "updated_at": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "fresh_for_hours": { "type": "number", "minimum": 1, "maximum": 24 },
        "source": { "type": "string", "minLength": 1 },
        "trust_limit": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moonraker_method", "reference", "pass", "blocker"],
      "properties": {
        "moonraker_method": { "type": "string", "pattern": "^[a-z]+(?:\\.[a-z_]+)+$" },
        "reference": { "type": "string", "pattern": "^https://moonraker\\.readthedocs\\.io/" },
        "pass": { "type": "string", "minLength": 1 },
        "blocker": { "type": "string", "minLength": 1 }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "probe"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "probe": { "$ref": "#/$defs/probe" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "moonraker_method", "reference", "allowed_states"],
      "properties": {
        "name": { "enum": ["pause", "resume", "cancel", "start_print", "upload_gcode"] },
        "moonraker_method": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "pattern": "^https://moonraker\\.readthedocs\\.io/" },
        "allowed_states": { "type": "array", "minItems": 1, "items": { "enum": ["idle", "ready", "printing", "paused"] } }
      }
    },
    "telemetry_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "moonraker_object", "path", "nullable"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "moonraker_object": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "nullable": { "type": "boolean" }
      }
    }
  }
}
