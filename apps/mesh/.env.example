# Один образ apps/mesh используется в трёх режимах:
#   HTTP API (команда Docker по умолчанию, порт 3101),
#   `mesh-worker` для конвертации ревизий,
#   `mesh-slice-worker` для слайсинга.
# Для каждого процесса используйте отдельный контейнер с общим набором секретов.

# Общая PostgreSQL и S3. Для HTTP без них часть операций вернёт контролируемую ошибку;
# воркеры без них простаивают и не забирают задания.
DATABASE_URL=postgresql://portal:<пароль>@postgres:5432/portal
S3_ENDPOINT=https://s3.example.ru
S3_REGION=ru-central-1
S3_BUCKET_MODELS=3mf
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Воркер конвертации mesh-worker ---

# Fail-closed: 1 ставьте только после миграций и проверки очереди в целевом окружении.
MESH_REVISION_WORKER_ENABLED=0
MESH_POLL_INTERVAL_SECONDS=5
MESH_MAX_ATTEMPTS=3
MESH_LEASE_SECONDS=120
MESH_HEARTBEAT_INTERVAL_SECONDS=30
MESH_SHUTDOWN_GRACE_SECONDS=30

# --- Воркер слайсинга mesh-slice-worker ---

# Fail-closed: 1 разрешает забирать slice_jobs; старого unfenced fallback нет.
MESH_SLICE_LIFECYCLE_ENABLED=0
MESH_SLICE_MAX_ATTEMPTS=3
MESH_SLICE_LEASE_SECONDS=300
MESH_SLICE_HEARTBEAT_INTERVAL_SECONDS=60
MESH_SLICE_SHUTDOWN_GRACE_SECONDS=60

# Обязательно для включённого слайсинга: бинарник и Ed25519-ключ подписи slice-trust.v1.
# Приватный PEM-файл монтируется только для чтения и не хранится в Git.
SLICER_BINARY_PATH=/usr/bin/prusa-slicer
MESH_SLICE_TRUST_PRIVATE_KEY_PATH=/run/secrets/mesh/slice-trust.pem
MESH_SLICE_TRUST_KEY_ID=

# JSON-реестр публичных ключей нужен при ротации; пусто — только активный ключ.
MESH_SLICE_TRUST_PUBLIC_KEYS_PATH=

# Ограничения процесса PrusaSlicer.
SLICER_CPU_QUOTA_PERCENT=150
SLICER_MEMORY_MAX_MB=1536
SLICER_TASKS_MAX=16
SLICER_TIMEOUT_SECONDS=300

# Опциональный OrcaSlicer. Если бинарник не задан, этот движок недоступен.
SLICER_ORCA_BINARY_PATH=
MESH_ORCA_PROFILES_DIR=
SLICER_ORCA_CPU_QUOTA_PERCENT=150
SLICER_ORCA_MEMORY_MAX_MB=2048
SLICER_ORCA_TASKS_MAX=16
SLICER_ORCA_TIMEOUT_SECONDS=600

# --- Лимиты HTTP-обработки файлов ---

MESH_MAX_FILE_BYTES=524288000
MESH_MAX_TRIANGLES=20000000
MESH_MAX_ZIP_UNCOMPRESSED_BYTES=1073741824
MESH_MAX_ZIP_COMPRESSION_RATIO=100
MESH_MAX_ZIP_ENTRIES=10000
MESH_PARSE_TIMEOUT_SECONDS=60
MESH_PARSE_MEMORY_BYTES=2147483648
MESH_MAX_REPAIR_TRIANGLES=2000000

# Порог perceptual hash для определения дубликатов фото. Пусто — дефолт из кода.
MAKE_PHOTO_DUPLICATE_HAMMING_THRESHOLD=

# Каталог textfile collector node_exporter. Пусто — метрики остаются только в логах.
PORTAL_QUEUE_METRICS_DIR=
