# Имена переменных без значений — см. SECURITY.md § «Секреты». Реальный .env — только
# локально/на VDS/в GitVerse Actions Secrets, никогда не коммитится (в .gitignore).

# apps/api — Postgres
DATABASE_URL=postgres://portal:portal@localhost:5432/portal

# apps/api — закрытая разработка (MF-1032, директива оператора): CLOSED_DEV=1 — гость видит
# только /health и /auth/* (login), публичные read-пути MF-850/912/834/878/889 закрыты. На
# проде задаёт Ops (VDS 176.123.160.18, портал не имеет доступа) — заявка передана отдельно.
CLOSED_DEV=1

# apps/api — сессия портала (JWT-cookie на .3mf.tech)
JWT_SECRET=
COOKIE_DOMAIN=.3mf.tech
# WEB_APP_URL — единственный домен, куда редиректим после логина/ошибки (auth/plagid.ts).
WEB_APP_URL=https://3mf.tech
# API_PUBLIC_URL — хост бот-мета/OG-ссылок этого инстанса (MF-505/MF-827, src/seo/urls.ts:
# og:image = API_PUBLIC_URL + /seo/models/:id/og.webp). Дефолт в коде — https://api.3mf.tech,
# совпадает с прод-доменом, поэтому здесь не задаётся явно. Dev-инстанс ОБЯЗАН переопределить
# на https://api.dev.3mf.tech — см. deploy/portal.dev.api.env.example, иначе og:image указывает
# на прод API и отдаёт 404 для моделей, которых нет в prod БД.
# CORS_ALLOWED_ORIGINS — comma-list origins для CORS (server.ts); опционально, дефолт =
# WEB_APP_URL. На проде включает dev-контур, который ходит в прод API:
# CORS_ALLOWED_ORIGINS=https://3mf.tech,https://dev.3mf.tech

# apps/api — модель данных авторизации (epics/auth.triple.md § «Модель данных»)
AUTH_HMAC_KEY=
AUTH_ENCRYPTION_KEY=

# apps/api — bootstrap локального администратора. ADMIN_USERNAME обязан соответствовать формату
# username портала: 3-32 символа, только lowercase a-z, цифры и точки, без точки по краям.
# ADMIN_PASSWORD — минимум 12 символов. Только явный NODE_ENV=development разрешает минимум 8
# для локальной среды. Login и password задаются вместе. UUID генерируется один раз и
# сохраняется в singleton marker. Изменение ADMIN_PASSWORD ротирует credential и sessions.
# Реальные значения — только в env на сервере, не в git.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# apps/api — креды агента устройства (MF-795, парк/enroll эпика MF-26): подписывает bearer-
# токен, который агент получает при редимпшене enroll-кода и предъявляет relay (MF-794).
# Отдельный секрет от JWT_SECRET намеренно — другая граница доверия (годовой токен процесса
# на чужом железе, не 30-дневная cookie юзера в браузере), см. SECURITY.md § «Секреты».
AGENT_JWT_SECRET=

# apps/api + compiled Nest apps/relay — отдельный service-to-service credential для
# canonical `/internal/relay/v1/*`. Это НЕ AGENT_JWT_SECRET и не gateway credential.
# Значение 32..512 символов; одно и то же значение задаётся API и relay только через
# защищённые env/secret-файлы. Старые RELAY_INTERNAL_TOKEN/API_INTERNAL_URL запрещены.
RELAY_SERVICE_TOKEN=

# apps/relay — независимый compiled Nest process. Gateway WSS/mTLS и HTTP observability
# обязаны слушать разные адреса/порты. Внешний L4 proxy направляет только gateway TLS;
# `/health`, `/ready`, `/metrics` доступны только на loopback observability listener.
RELAY_PROTOCOL_VERSION=v1
RELAY_INSTANCE_ID=
RELAY_API_BASE_URL=https://api.3mf.tech
RELAY_API_TIMEOUT_MS=1000
RELAY_API_RETRY_ATTEMPTS=2
RELAY_API_RETRY_BASE_DELAY_MS=50
RELAY_GATEWAY_HOST=127.0.0.1
RELAY_GATEWAY_PORT=8443
RELAY_OBSERVABILITY_HOST=127.0.0.1
RELAY_OBSERVABILITY_PORT=9091
RELAY_TLS_CERT_FILE=
RELAY_TLS_KEY_FILE=
RELAY_TLS_CA_FILE=
RELAY_MAX_FRAME_BYTES=131072
RELAY_MAX_SESSIONS=10000
RELAY_MAX_INFLIGHT_FRAMES=1024
RELAY_MAX_INFLIGHT_FRAMES_PER_SESSION=4
RELAY_MAX_FRAMES_PER_SECOND=60
RELAY_MAX_BUFFERED_BYTES=67108864
RELAY_MAX_BUFFERED_BYTES_PER_SESSION=1048576
RELAY_HELLO_TIMEOUT_MS=10000
RELAY_HEARTBEAT_SWEEP_MS=1000
RELAY_REVALIDATION_INTERVAL_MS=2000
RELAY_REVALIDATION_TIMEOUT_MS=1000
RELAY_REVALIDATION_FAIL_CLOSED_MS=5000
RELAY_SHUTDOWN_DRAIN_MS=10000

# apps/api — обмен с auth.plag.space (PlagID), тот же секрет что EXTERNAL_TOKEN_SECRET воркера
PLAGID_EXTERNAL_TOKEN_SECRET=
PLAGID_CALLBACK_URL=https://api.3mf.tech/auth/plagid/callback

# apps/api — SberID (MF-356, epics/auth.triple.md § «Метод 3») — партнёрские креды, заводит
# Валерий; без них /auth/sberid/* остаётся заглушкой 501 (src/auth/sberid.ts)
SBERID_CLIENT_ID=
SBERID_CLIENT_SECRET=

# apps/api — S3 (cloud.ru), бакет auth — опционально: без них сырые claims не сохраняются,
# логин продолжает работать через identifier_hash в Postgres (см. src/storage/s3.ts)
S3_ENDPOINT=https://s3.cloud.ru
S3_REGION=ru-central-1
S3_BUCKET_AUTH=auth
S3_ACCESS_KEY=
S3_SECRET_KEY=

# apps/api (аплоад моделей, MF-455) + apps/mesh (воркер конвертации, MF-456) — бакет `3mf`.
# Воркер apps/mesh читает те же DATABASE_URL и S3-креды выше; без кредов простаивает,
# при выключенном revision worker не claim'ит jobs. Интервал поллинга — опционально (дефолт 5с).
S3_BUCKET_MODELS=3mf
MESH_POLL_INTERVAL_SECONDS=5
# Fail-closed gate for the revision-aware model_revisions consumer. Keep 0 until
# its migration and crash/reclaim pilot gates have passed in the target environment.
MESH_REVISION_WORKER_ENABLED=0
MESH_MAX_ATTEMPTS=3
MESH_LEASE_SECONDS=120
MESH_HEARTBEAT_INTERVAL_SECONDS=30
MESH_SHUTDOWN_GRACE_SECONDS=30

# apps/mesh — воркер очереди слайсинга (mesh-slice-worker, MF-1992): Ed25519 подпись
# обязательного `slice-trust.v1` (docs/contracts/slice-trust.v1.md). Приватный ключ — PEM-файл
# вне git (openssl genpkey -algorithm ed25519), только .env/файл на VDS (SECURITY.md). Без этих
# двух переменных воркер простаивает по ВСЕЙ очереди слайсинга (не падает, src/mesh/slicing_queue.py
# run_slice_loop). MESH_SLICE_TRUST_PUBLIC_KEYS_PATH — опционально: JSON-реестр {key_id: base64
# raw 32 bytes} с публичными ключами retired-ключей для проверки уже закэшированных
# slice_cache_entries после ротации; активный key_id всегда выводится из приватного ключа.
MESH_SLICE_TRUST_PRIVATE_KEY_PATH=
MESH_SLICE_TRUST_KEY_ID=
MESH_SLICE_TRUST_PUBLIC_KEYS_PATH=
# Fail-closed switch for the fenced slice_jobs adapter. 0 disables claims; there
# is no fallback to the removed unfenced polling loop.
MESH_SLICE_LIFECYCLE_ENABLED=0
MESH_SLICE_MAX_ATTEMPTS=3
MESH_SLICE_LEASE_SECONDS=300
MESH_SLICE_HEARTBEAT_INTERVAL_SECONDS=60
MESH_SLICE_SHUTDOWN_GRACE_SECONDS=60

# apps/api — клиент HTTP-поверхности apps/mesh (MF-842/MF-1793): POST /makes проксирует фото
# сюда (makes/meshClient.ts). Порт 3101, не 3100 — на VDS 3100 занят docker-proxy
# multica-frontend, см. apps/mesh/deploy/portal.mesh-http.service.
MESH_HTTP_URL=http://127.0.0.1:3101

# apps/api — исторический service-account allowlist для удалённого POST /models/:id/featured.
# Активного runtime consumer нет; административная авторизация использует permissions.
ADMIN_USERNAMES=

# apps/api — dev-вход временной среды dev.3mf.tech (MF-532, src/auth/dev.ts). ТОЛЬКО для
# dev-инстанса: POST /auth/dev выдаёт сессию devuser без проверки личности. Двойной
# предохранитель — работает лишь при NODE_ENV!=production И AUTH_DEV_BYPASS=1; иначе /auth/dev
# отвечает 404. НИКОГДА не ставить на проде. Полный env-шаблон dev-инстанса —
# deploy/portal.dev.api.env.example.
AUTH_DEV_BYPASS=

# apps/web — баннер «DEV-среда» (MF-532, src/dev/devbanner.tsx). Vite вшивает на build:
# web dev-инстанса собирается с VITE_DEV_BANNER=1 (прод собирается без него). См. также
# VITE_API_URL=https://api.dev.3mf.tech для dev-сборки web.
VITE_DEV_BANNER=

# apps/giga — воркер генерации по тексту (MF-351): очередь/статусы в таблице
# `generations` (тот же DATABASE_URL), артефакты — отдельный бакет S3 (те же креды выше).
GIGA_LIFECYCLE_ENABLED=0
GIGA_MAX_ATTEMPTS=3
GIGA_LEASE_SECONDS=300
GIGA_HEARTBEAT_INTERVAL_SECONDS=60
GIGA_SHUTDOWN_GRACE_SECONDS=60
ASSISTANT_LIFECYCLE_ENABLED=0
ASSISTANT_MAX_ATTEMPTS=3
ASSISTANT_LEASE_SECONDS=90
ASSISTANT_HEARTBEAT_INTERVAL_SECONDS=20
ASSISTANT_SHUTDOWN_GRACE_SECONDS=30
SEARCH_LIFECYCLE_ENABLED=0
SEARCH_HEARTBEAT_INTERVAL_SECONDS=30
SEARCH_SHUTDOWN_GRACE_SECONDS=30
# Optional node_exporter textfile-collector directory. Each process writes its
# own <queue>.prom file atomically; leave empty to keep log-only metrics.
PORTAL_QUEUE_METRICS_DIR=
# Без кредов lifecycle worker простаивает и не claim'ит jobs. Интервал поллинга —
# опционально (дефолт 5с).
S3_BUCKET_GENERATIONS=generations
GIGA_POLL_INTERVAL_SECONDS=5

# apps/giga — для веток генерации 3D через RuDALL-E обязательны оба значения.
RUDALLE_API_URL=
RUDALLE_API_TOKEN=

# apps/api — offload публичного чтения `3mf`/`generations` на прямой cloud.ru URL вместо
# api-прокси (MF-709/MF-703, src/storage/s3.ts). Оба должны быть заданы вместе — иначе offload
# выключен и отдача остаётся прокси-стримом (текущее поведение). Cloud.ru подтвердил (MF-715):
# голый path-style `s3.cloud.ru/<bucket>` анонимно НЕ работает (нет tenant id) — не ставить ни
# как дефолт, ни как временный fallback. Рабочих схемы две, обе ждут Domain/Global name из
# консоли cloud.ru (MF-715, ещё blocked):
#   S3_PUBLIC_URL_STYLE=vhost   + S3_PUBLIC_ENDPOINT=https://s3.cloud.ru      → <bucket-или-domain-name>.s3.cloud.ru/<key>
#   S3_PUBLIC_URL_STYLE=global  + S3_PUBLIC_ENDPOINT=https://global.s3.cloud.ru → global.s3.cloud.ru/<global-name>/<key> (S3_BUCKET_* = global-name)
S3_PUBLIC_ENDPOINT=
S3_PUBLIC_URL_STYLE=

# apps/giga — ветка openscad (MF-352): GigaCode→OpenSCAD через текстовую генерацию GigaChat
# (`gigachat.GigaChat.chat`, src/giga/gigachat_client.py::ask_text). Нужен готовый
# GIGACHAT_CREDENTIALS (base64 Authorization key) либо оба GIGACHAT_CLIENT_ID и
# GIGACHAT_API_KEY; эта же пара подходит ассистенту. Без них ветка отвечает
# status=error по конкретной генерации, воркер не падает.
# Ветка дополнительно требует системный бинарник `openscad` в PATH (apt-пакет `openscad`,
# ставит Ops) — без него тоже status=error, а не падение воркера.
GIGACHAT_CREDENTIALS=
GIGACHAT_CLIENT_ID=
GIGACHAT_API_KEY=

# apps/giga — локальная Gemma для prompt variants (MF-2067): OpenAI-compatible endpoint
# на HYPERPC, доступный только серверу через Tailscale. Браузер и apps/web к нему напрямую
# не обращаются. Не задан — `/assistant/prompt-variants` отвечает 503, платного fallback нет.
HYPERPC_FAST_URL=

# apps/giga — ветки kzd/hueforge/trellis (MF-352/MF-2001): изображение по тексту через
# OpenRouter Images API (`POST /api/v1/images`, src/giga/openrouter_client.py) — переключены
# с GigaChat 2026-07-20 (GIGACHAT_CREDENTIALS на VDS никогда не был сконфигурирован, ветки не
# работали). Модель по умолчанию — `black-forest-labs/flux.2-klein-4b` ($0.014/мегапиксель,
# переопределяется OPENROUTER_IMAGE_MODEL), сверена вручную с Seedream 4.5: даёт чистый силуэт
# без лишней подставки, дешевле втрое. Без OPENROUTER_API_KEY ветки отвечают status=error по
# конкретной генерации, воркер не падает (тот же паттерн, что GIGACHAT_CREDENTIALS выше).
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=

# apps/giga — ветка trellis (MF-2001): 2-3 референс-картинки с разных ракурсов (OpenRouter,
# выше) → 3D-меш через TRELLIS.2/ComfyUI, мульти-вид (src/giga/branches/{trellis,
# comfyui_client}.py). COMFYUI_URL — адрес ComfyUI на HYPERPC (Tailscale-only, слот 3, см.
# docs/process/hyperpc.local.llm.md); наружу не проксируется, браузер этот адрес никогда не
# видит. Не задан — ветка отвечает status=error по конкретной генерации, воркер не падает
# (тот же паттерн, что OPENROUTER_API_KEY выше). Остальные COMFYUI_* — таймауты/ретраи/окно
# поиска экспортированного файла, у всех есть рабочие дефолты в коде.
COMFYUI_URL=
# Ветка concepts (MF-2067) использует установленный в этом ComfyUI Z-Image-Turbo. Имена
# файлов намеренно задаются окружением: они зависят от раскладки models/ на GPU-хосте.
# Без любого из трёх значений ветка concepts завершается контролируемой ошибкой.
ZIMAGE_UNET_NAME=
ZIMAGE_CLIP_NAME=
ZIMAGE_VAE_NAME=

# apps/api — лимиты/модерация генераций (MF-353 п.1-3, MF-657, src/generations/*). Все
# опциональны — не заданы → используются дефолты в коде, ничего не ломается.
# GENERATION_QUOTA_HOURLY / GENERATION_QUOTA_DAILY — per-user квоты на POST /generations
# (дефолт 10/час, 30/сутки) — превышение отвечает 429 RATE_LIMITED.
GENERATION_QUOTA_HOURLY=
GENERATION_QUOTA_DAILY=
# GENERATION_BLOCKED_WORDS — comma-list доп. запрещённых слов к встроенному MVP-фильтру
# промптов (moderation.ts) — правка списка без деплоя.
GENERATION_BLOCKED_WORDS=
# GENERATION_STALE_TIMEOUT_MINUTES — через сколько минут без обновления зависший
# queued/running job лениво переводится в status=error (дефолт 15).
GENERATION_STALE_TIMEOUT_MINUTES=

# apps/scout — парсер-контур кандидатов станков (MF-623): читает тот же DATABASE_URL,
# пишет machine_candidates/release_events. Без DATABASE_URL воркер простаивает, не
# падает (src/scout/worker.py). Интервал между полными прогонами источников —
# опционально (дефолт час: обход внешних вендор-сайтов, не поллинг живой очереди).
SCOUT_POLL_INTERVAL_SECONDS=3600

# apps/api — веб-пуш транспорт (MF-434, Фаза 3 эпика MF-42, src/push/*): W3C Web Push + VAPID,
# свой push-сервер (не FCM). VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY — сгенерировать один раз через
# `npx web-push generate-vapid-keys` и захранить как есть; без них /push/* отвечает пустым
# public_key и рассылка молча no-op с warn в лог (тот же паттерн, что email/send.ts для SMTP).
# VAPID_SUBJECT — контактный mailto:/https: для пуш-вендоров (дефолт mailto:ops@3mf.tech).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# apps/api — эквайринг ЮKassa (MF-364/MF-1025, src/billing/*): создание платежа за платную
# модель + вебхук succeeded/canceled. YOOKASSA_SHOP_ID/YOOKASSA_SECRET_KEY — креды Payments API
# тестового магазина (Basic auth), НЕ путать с Payouts API (MF-1027, отдельный продукт/креды).
# Без них POST /purchases отвечает 503, платёж не создать (в отличие от push/email — оплата не
# no-op-ится молча). BILLING_TAKE_RATE_BPS — доля платформы в базисных пунктах (дефолт 2000 =
# 20%, не зафиксировано оператором). BILLING_HOLD_DAYS — холд seller_balance перед доступностью
# к выводу (дефолт 14 дней).
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
BILLING_TAKE_RATE_BPS=
BILLING_HOLD_DAYS=

# apps/api — выплаты авторам (MF-364 фаза 2, шаг 3, src/billing/routes.ts POST /payouts).
# YOOKASSA_AGENT_ID/YOOKASSA_PAYOUTS_SECRET_KEY — креды Payouts API (SECURITY.md § «Секреты»,
# выданы Ops MF-1024) — ДРУГОЙ продукт ЮKassa, чем YOOKASSA_SHOP_ID/YOOKASSA_SECRET_KEY выше
# (Payments API), креды нельзя переиспользовать. _SECRET_KEY переименован из SECURITY.md
# (там оба продукта названы одинаково YOOKASSA_SECRET_KEY) — здесь это два разных env var, не
# может быть одного имени на два разных секрета. Пока не консьюмятся кодом: списание с баланса +
# payouts.status на старте обрабатываются вручную (staff, PATCH /payouts/:id) — автоматический
# вызов Payouts API на выплату вне скоупа этой карточки, задел под будущую интеграцию.
YOOKASSA_AGENT_ID=
YOOKASSA_PAYOUTS_SECRET_KEY=
