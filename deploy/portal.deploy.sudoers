# sudoers drop-in для portal deploy scripts: passwordless sudo только на точные
# stop/start-команды управляемых API и restart compiled Nest relay unit, ничего шире.
#
# Установка на VDS:
#   sudo cp deploy/portal.deploy.sudoers /etc/sudoers.d/portal.deploy
#   sudo chmod 440 /etc/sudoers.d/portal.deploy
#   sudo visudo -cf /etc/sudoers.d/portal.deploy

plag ALL=(root) NOPASSWD: /usr/bin/systemctl stop portal.api
plag ALL=(root) NOPASSWD: /usr/bin/systemctl start portal.api
plag ALL=(root) NOPASSWD: /usr/bin/systemctl stop portal.api-dev
plag ALL=(root) NOPASSWD: /usr/bin/systemctl start portal.api-dev
plag ALL=(root) NOPASSWD: /usr/bin/systemctl restart portal.relay-dev.service
