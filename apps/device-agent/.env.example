# Canonical production connector selection. Unknown connector types and fields fail closed.
DEVICE_CONNECTOR_CONFIG='{"type":"moonraker","httpUrl":"http://PRINTER_LAN_IP:7125"}'

RELAY_URL=wss://relay.example.invalid/relay/ws
MULTICA_AGENT_HOME=/var/lib/3mf-device-agent
RELAY_TLS_CERT_FILE=/var/lib/3mf-device-agent/gateway-certificate.pem
RELAY_TLS_KEY_FILE=/var/lib/3mf-device-agent/gateway-key.pem
RELAY_TLS_CA_FILE=/var/lib/3mf-device-agent/gateway-ca.pem
AGENT_HEALTH_PORT=9797
AGENT_SHUTDOWN_DEADLINE_MS=10000

# Build metadata is embedded by the signed release. Development runs must set both values.
AGENT_VERSION=0.0.0-dev
AGENT_COMMIT_SHA=0000000

# Public Ed25519 verification keys are provisioned by CSR enrollment into
# $MULTICA_AGENT_HOME/command-verification-keys.json. No command signing secret is stored here.
