# Скопируйте файл в apps/web/.env для локальной разработки.
# Переменные VITE_* встраиваются в браузерный бандл во время сборки и не являются секретами.
# Для Docker их нужно передать именно на этапе `vite build`; изменение env запущенного nginx
# уже не изменит собранный фронтенд. Сейчас Dockerfile объявляет аргумент только VITE_API_URL;
# перед подключением остальных значений в CI для них нужно добавить соответствующие ARG/ENV.

# Обязательно: публичный адрес API, доступный браузеру пользователя.
VITE_API_URL=https://api.example.ru

# 1 — закрыть интерфейс авторизацией. Значение должно соответствовать CLOSED_DEV в apps/api.
VITE_CLOSED_DEV=1

# 1 — показать заметный баннер тестового окружения; для production оставьте пустым.
VITE_DEV_BANNER=

# 1 — включить браузерные моки. Только для локальной разработки, не включать на стендах.
VITE_MOCK=

# 1 — включить расширенный интерфейс проектов, если он нужен на этом контуре.
VITE_PROJECTS_WIDE=

# Идентификатор сайта Umami. Пусто — аналитика не подключается.
VITE_UMAMI_WEBSITE_ID=
