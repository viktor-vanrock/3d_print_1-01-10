# Портальный ассистент: процесс giga-assistant-worker.
# После миграций и проверки доступа к API переключите lifecycle на 1.
DATABASE_URL=postgresql://portal:<пароль>@postgres:5432/portal
ASSISTANT_LIFECYCLE_ENABLED=0
ASSISTANT_INTERNAL_API_ORIGIN=http://api
# Тот же секрет (32–512 символов) задаётся в apps/api как ASSISTANT_SERVICE_TOKEN.
ASSISTANT_SERVICE_TOKEN=
GIGACHAT_CLIENT_ID=
GIGACHAT_API_KEY=
# Если выдан GIGA_AUTH_KEY, его значение можно записать как GIGACHAT_CREDENTIALS.
# ift или prod; prod использует api.giga.chat/v1 и ngw.devices.sberbank.ru:9443/api/v2/oauth.
GIGACHAT_ENVIRONMENT=ift
PORTAL_QUEUE_METRICS_DIR=/tmp/giga-assistant-metrics

# Только для отдельного процесса giga-worker, который генерирует 3D.
# Для ассистента эти переменные не нужны. Провайдеры отдельных веток генерации
# настраиваются только при их использовании.
GIGA_LIFECYCLE_ENABLED=0
# Для веток генерации 3D через RuDALL-E обязательны оба значения.
# Dev: https://rudalle-coordinator.dev.sberdevices.ru/api/
# Prod: https://rudalle-coordinator.sberdevices.ru/api/

RUDALLE_API_URL=
RUDALLE_API_TOKEN=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
