# systemd-юнит разового прогона источника slicer_print_profiles_cura (MF-411,
# шаг 3 фазы 1 эпика MF-34, часть Cura, последний хвост шага 3):
# scout-slicer-print-profiles-cura-agent (Cura quality-тиры Ultimaker/Cura +
# материалы Ultimaker/fdm_materials) -> slicer_profile_candidates/slicer_profiles.
# Отдельный юнит от portal.scout-slicer-print-profiles{,-prusa}.service (другой
# формат/другой парсер/два разных исходных репозитория с разными лицензиями),
# тот же принцип "не на тике portal.scout-worker" (MF-627/MF-719/MF-411):
# источник редкий, ~290 GET-запросов за прогон.
#
# Установка на VDS (после uv sync в apps/scout, см. portal.scout-worker.service):
#   sudo cp deploy/portal.scout-slicer-print-profiles-cura.service deploy/portal.scout-slicer-print-profiles-cura.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now portal.scout-slicer-print-profiles-cura.timer
#   journalctl -u portal.scout-slicer-print-profiles-cura -f     # логи последнего прогона
#
# EnvironmentFile ~/portal.scout.env (общий с portal.scout-worker.service) —
# DATABASE_URL (обязателен), GITHUB_TOKEN (опционален).

[Unit]
Description=portal.ru scout slicer_print_profiles_cura agent (cura quality+material -> slicer_profiles)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=plag
WorkingDirectory=/home/plag/portal.ru/apps/scout
EnvironmentFile=/home/plag/portal.scout.env
ExecStart=/home/plag/.local/bin/uv run --no-dev scout-slicer-print-profiles-cura-agent
StandardOutput=journal
StandardError=journal
