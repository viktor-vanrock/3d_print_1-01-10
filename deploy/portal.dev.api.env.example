# Шаблон env-файла api dev-инстанса dev.3mf.tech (эпик MF-532, env-контракт §5 «Итогов совета»).
# Реальный файл на VDS — ~/portal.dev.api.env, заполняет Ops; секреты НЕ коммитятся (SECURITY.md).
# Значения-плейсхолдеры "<...>" замените реальными; строки без значения — секреты, задаёт Ops.
#
# ЖЁСТКИЙ инвариант изоляции: dev НИКОГДА не пишет в прод-БД/прод-бакеты. Отдельная БД
# portal_dev, отдельная dev-роль (права только на portal_dev), отдельный бакет 3mf-dev,
# свой JWT_SECRET ≠ прод, COOKIE_DOMAIN=.dev.3mf.tech.

# --- Среда и dev-вход (двойной предохранитель, apps/api/src/auth/dev.ts) ---
# NODE_ENV != production И AUTH_DEV_BYPASS=1 — только вместе открывают POST /auth/dev.
# Оба обязательны; на проде этих строк НЕТ.
NODE_ENV=development
AUTH_DEV_BYPASS=1

# --- Закрытая разработка (MF-1032, директива оператора) ---
# CLOSED_DEV=1 — гость видит только /health, /auth/* (login) и безопасный GET /printers
# для поиска канона в «Моём парке»; остальные публичные read-пути закрыты. Снять флаг
# откатывает открытие остальных публичных чтений обратно за один деплой.
CLOSED_DEV=1

# Порт api dev-инстанса (loopback, за nginx-vhost api.dev.3mf.tech).
# ВНИМАНИЕ Ops: на текущем VDS 127.0.0.1:3100 уже занят контейнером multica-frontend —
# сверьтесь (ss -ltnp | grep 3100) и при конфликте возьмите свободный порт (напр. 3200).
PORT=3100

# --- Сессия портала (JWT-cookie на .dev.3mf.tech) ---
# JWT_SECRET ОБЯЗАН отличаться от прод-секрета (иначе прод-cookie валидна на dev и наоборот).
JWT_SECRET=
COOKIE_DOMAIN=.dev.3mf.tech
# WEB_APP_URL — единственный redirect-target после логина/ошибки на ЭТОМ инстансе
# (per-env: у прод свой https://3mf.tech, здесь свой). НЕ путать с CORS_ALLOWED_ORIGINS
# (MF-636) — тот comma-list живёт в ~/portal.api.env (прод), сюда его добавлять не надо:
# здесь NODE_ENV=development, CORS уже открыт (server.ts: origin=true вне production).
WEB_APP_URL=https://dev.3mf.tech

# --- Бот-мета/OG (MF-505/MF-827, apps/api/src/seo/urls.ts) ---
# API_PUBLIC_URL — хост, на котором отдаётся og:image (/seo/models/:id/og.webp) и другие
# публичные SEO-ссылки этого инстанса. По умолчанию в коде — https://api.3mf.tech (прод) —
# без этой строки og:image на dev.3mf.tech указывает на ПРОД api и отдаёт 404 для моделей,
# которых нет в prod БД (найдено живой проверкой MF-827: og:image 404 на dev-модели).
API_PUBLIC_URL=https://api.dev.3mf.tech

# --- Admin-allowlist featured (вердикт §1: на dev devuser входит в allowlist) ---
# Живая перепометка hero — сама цель среды; пишет только в portal_dev.
ADMIN_USERNAMES=devuser

# --- Bootstrap локального администратора (опционально) ---
# Логин: 3-32 lowercase символа из a-z, 0-9 и точек; пароль: минимум 8 символов только здесь,
# потому что этот шаблон задаёт NODE_ENV=development (production по-прежнему требует 12).
# Login и password задаются вместе; UUID хранится в singleton DB marker.
# Изменение password при startup ротирует credential и инвалидирует sessions.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Postgres: отдельная БД portal_dev + отдельная dev-роль (вердикт §3) ---
DATABASE_URL=postgres://<dev_role>:<dev_password>@127.0.0.1:5432/portal_dev

# --- Модель данных авторизации (те же ключи, что на проде, но свой инстанс) ---
AUTH_HMAC_KEY=
AUTH_ENCRYPTION_KEY=

# --- PlagID (опционально на dev: основной вход — /auth/dev; PlagID можно не заводить) ---
PLAGID_EXTERNAL_TOKEN_SECRET=
PLAGID_CALLBACK_URL=https://api.dev.3mf.tech/auth/plagid/callback

# --- S3/MinIO: отдельный dev-бакет 3mf-dev (вердикт §4), НЕ префикс прод-бакета ---
S3_ENDPOINT=https://s3.cloud.ru
S3_REGION=ru-central-1
S3_BUCKET_MODELS=3mf-dev
S3_BUCKET_AUTH=auth-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=
