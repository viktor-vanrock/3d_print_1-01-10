# Образ запускает `search-worker`: он забирает задания индексации из PostgreSQL,
# получает модель из S3, строит эмбеддинг через HyperPC и сохраняет результат в БД.
# Без обязательных настроек процесс не падает, но простаивает и не обрабатывает очередь.

# Обязательно для рабочего воркера.
DATABASE_URL=postgresql://portal:<пароль>@postgres:5432/portal
HYPERPC_URL=http://hyperpc:8189
S3_ENDPOINT=https://s3.example.ru
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Опциональные настройки S3; указаны текущие дефолты.
S3_REGION=ru-central-1
S3_BUCKET_MODELS=3mf

# Fail-closed переключатель. Оставьте 0 до применения миграций и проверки lease/reclaim.
# 1 разрешает воркеру забирать задания search_index_jobs.
SEARCH_LIFECYCLE_ENABLED=0

SEARCH_POLL_INTERVAL_SECONDS=5
SEARCH_INDEX_LEASE_SECONDS=120
SEARCH_INDEX_MAX_ATTEMPTS=5
SEARCH_HEARTBEAT_INTERVAL_SECONDS=30
SEARCH_SHUTDOWN_GRACE_SECONDS=30

# Пусто — id формируется автоматически из имени воркера и PID.
SEARCH_WORKER_ID=

# Таймауты обращения к HyperPC.
HYPERPC_TIMEOUT_SECONDS=10
HYPERPC_MAX_RETRIES=2
HYPERPC_RETRY_BACKOFF_SECONDS=0.5

# Каталог textfile collector node_exporter. Пусто — метрики остаются только в логах.
PORTAL_QUEUE_METRICS_DIR=
