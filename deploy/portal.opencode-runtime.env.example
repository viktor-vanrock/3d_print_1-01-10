# Шаблон ~/portal.opencode-runtime.env (chmod 600, не в git).
# Отдельный от ~/portal.giga-dev.env НАМЕРЕННО — тот файл несёт
# GIGACHAT_CREDENTIALS/OPENROUTER_API_KEY, этому контейнеру они не нужны и
# не должны быть в его окружении (см. docs/infra/opencode.assistant.runtime.md
# про "0 credentials", тот же принцип, что у ocsearch runtime на `worker`).

# HYPERPC slot 1 (:1236, tool calling) — Tailscale-only, см.
# docs/process/hyperpc.local.llm.md. Без него контейнер стартует без
# провайдеров (не падает).
HYPERPC_STRUCTURED_URL=http://100.74.48.83:1236

# HYPERPC slot 2 (:1235, текст без tool calling) — опционально.
HYPERPC_FAST_URL=

# Пароль HTTP basic auth для `opencode serve` (см. deploy/opencode.runtime.dockerfile).
# Без него сервер стартует незащищённым — обязателен на любом хосте, где
# порт слушает не только 127.0.0.1.
OPENCODE_SERVER_PASSWORD=

# Хостовый порт публикации (только 127.0.0.1, см. compose-файл).
OPENCODE_RUNTIME_PORT=3104

# Версия образа — держать равной deploy/opencode.runtime.version, меняется
# только через deploy/opencode.runtime.rollout.sh.
OPENCODE_RUNTIME_VERSION=1.18.4
