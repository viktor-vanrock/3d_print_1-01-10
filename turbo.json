{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_API_URL", "VITE_DEV_BANNER"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "apps/web/.env*"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "env": ["DATABASE_URL", "AUTH_ENCRYPTION_KEY", "AUTH_HMAC_KEY"]
    },
    "typecheck": {
      "outputs": []
    }
  }
}
