[Unit]
Description=portal.ru source-backed news pipeline (local researcher/composer and Grok moderation)
Documentation=file:/home/plag/portal.ru-dev/apps/scout/deploy/readme.md
After=network-online.target
Wants=network-online.target
OnSuccess=portal.scout-news-publisher.service

[Service]
Type=oneshot
User=plag
WorkingDirectory=/home/plag/portal.ru-dev/apps/scout
EnvironmentFile=-/etc/portal/scout-news-pipeline.env
Environment=HOME=/home/plag
UnsetEnvironment=SCOUT_NEWS_FEED_INGEST_KEY AGENT_CONTENT_KEY XAI_API_KEY DATABASE_URL
StateDirectory=portal-scout-news
UMask=0077
ExecStart=/home/plag/portal.ru-dev/apps/scout/.venv/bin/scout-news-worker --output /var/lib/portal-scout-news/pipeline.json --parallel 3
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# Grok subscription/auth config stays read-only; only ephemeral session records are writable.
ReadWritePaths=/var/lib/portal-scout-news /home/plag/.grok/sessions
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
SystemCallArchitectures=native
