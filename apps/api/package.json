{
  "name": "@portal/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run db:migrate && node --loader ts-node/esm --watch src/nest/main.ts",
    "dev:nest": "pnpm run db:migrate && node --loader ts-node/esm --watch src/nest/main.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "node --run clean && tsc -b",
    "start": "node dist/nest/main.js",
    "start:nest": "node dist/nest/main.js",
    "typecheck": "tsc -b --noEmit && pnpm run typecheck:scripts && tsc -p db/migrations/tsconfig.json && tsc -p tsconfig.tools.json",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{ts,js,mjs,cjs}\"",
    "depcruise": "depcruise --config .dependency-cruiser.cjs --output-type err src/modules",
    "boundaries": "pnpm depcruise && cross-env NO_FASTIFY_STRICT=1 vitest run src/modules/_boundaries src/modules/_kernel",
    "no-fastify-residue:strict": "NO_FASTIFY_STRICT=1 vitest run src/modules/_boundaries/noFastifyResidue.test.ts",
    "openapi:generate": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm scripts/openapi-contract.ts",
    "openapi:check": "TS_NODE_TRANSPILE_ONLY=1 node --loader ts-node/esm scripts/openapi-contract.ts --check",
    "test": "vitest run",
    "test:project-api-v1-schema": "PROJECT_API_V1_SCHEMA_TEST=1 vitest run db/migrations/projectApiV1.migration.test.ts --maxWorkers=1",
    "test:model-revision-queue-schema": "QUEUE_LIFECYCLE_SCHEMA_TEST=1 vitest run db/migrations/modelRevisionQueueLifecycle.migration.test.ts --maxWorkers=1",
    "test:slice-queue-schema": "SLICE_QUEUE_LIFECYCLE_SCHEMA_TEST=1 vitest run db/migrations/sliceJobQueueLifecycle.migration.test.ts --maxWorkers=1",
    "test:generation-queue-schema": "GENERATION_QUEUE_LIFECYCLE_SCHEMA_TEST=1 vitest run db/migrations/generationQueueLifecycle.migration.test.ts --maxWorkers=1",
    "test:assistant-queue-schema": "ASSISTANT_QUEUE_FENCING_SCHEMA_TEST=1 vitest run db/migrations/assistantRunQueueFencing.migration.test.ts --maxWorkers=1",
    "test:search-lease-schema": "SEARCH_LEASE_GENERATION_SCHEMA_TEST=1 vitest run db/migrations/searchIndexLeaseGeneration.migration.test.ts --maxWorkers=1",
    "test:device-command-relay-schema": "DEVICE_COMMAND_RELAY_SCHEMA_TEST=1 vitest run db/migrations/deviceCommandRelayLifecycle.migration.test.ts --maxWorkers=1",
    "test:feed-manage-news-schema": "FEED_MANAGE_NEWS_SCHEMA_TEST=1 vitest run db/migrations/feedManageNewsPermission.migration.test.ts --maxWorkers=1",
    "test:device-command-relay-integration": "DEVICE_COMMAND_RELAY_INTEGRATION_TEST=1 vitest run src/modules/devices/infrastructure/device-command-relay.repository.integration.test.ts --maxWorkers=1",
    "test:relay-crash-restart-integration": "RELAY_CRASH_RESTART_INTEGRATION_TEST=1 vitest run src/modules/devices/infrastructure/relay-crash-restart.integration.test.ts --maxWorkers=1",
    "test:relay-control-plane-schema": "RELAY_CONTROL_PLANE_SCHEMA_TEST=1 vitest run db/migrations/relayControlPlane.migration.test.ts --maxWorkers=1",
    "test:relay-control-integration": "RELAY_CONTROL_INTEGRATION_TEST=1 vitest run src/modules/devices/infrastructure/relay-control.repository.integration.test.ts --maxWorkers=1",
    "test:legacy-project-import": "vitest run scripts/import-legacy-project-data.test.ts --maxWorkers=1",
    "test:operational-entrypoints": "vitest run scripts/operational-entrypoints.test.ts --maxWorkers=1",
    "test:operational-scripts": "vitest run scripts/*.test.ts src/modules/catalog/infrastructure/ingest src/modules/feed/domain/ranking.test.ts src/modules/feed/infrastructure/scores.test.ts src/modules/models/infrastructure/repo-backfill.test.ts --maxWorkers=1",
    "test:catalog-ingest": "vitest run src/modules/catalog/infrastructure/ingest --maxWorkers=1",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "seed:dev:live-printers": "tsx scripts/touch-dev-live-printers.ts",
    "provision:researcher": "tsx scripts/provision-researcher.ts",
    "fixtures:gen": "tsx scripts/fixtures/generate.ts",
    "import:machines-bootstrap": "tsx scripts/import-machines-bootstrap.ts",
    "import:materials-bootstrap": "tsx scripts/import-materials-bootstrap.ts",
    "import:forge-catalog": "tsx scripts/import-forge-catalog.ts",
    "import:ru-vendors-bootstrap": "tsx scripts/import-ru-vendors-bootstrap.ts",
    "import:legacy-project-data": "tsx scripts/import-legacy-project-data.ts",
    "ingest:run": "tsx scripts/ingest-run.ts",
    "resolve:run": "tsx scripts/resolve-run.ts",
    "import:run": "tsx scripts/import-run.ts",
    "feed:score-worker": "tsx scripts/feed-score-worker.ts",
    "sanctions:relay-outbox": "tsx scripts/sanctions-relay-outbox.ts",
    "sanctions:expire": "tsx scripts/sanctions-expire.ts",
    "backfill:repos": "tsx scripts/backfill-repos.ts",
    "db:migrate": "dbmate --migrations-dir db/migrations --schema-file db/schema.sql up",
    "db:rollback": "dbmate --migrations-dir db/migrations --schema-file db/schema.sql rollback",
    "db:new": "dbmate --migrations-dir db/migrations --schema-file db/schema.sql new",
    "db:status": "dbmate --migrations-dir db/migrations --schema-file db/schema.sql status",
    "db:check-migrations-dup": "bash scripts/check-migrations-dup.sh",
    "db:check-schema-sync": "bash scripts/check-schema-sync.sh",
    "db:check-migrate-replay-gate": "bash scripts/check-migrate-replay-gate.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@portal/contracts": "workspace:*",
    "busboy": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie": "^2.0.1",
    "express": "^5.2.1",
    "jose": "^5.9.0",
    "nodemailer": "^9.1.0",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "web-push": "^3.6.7",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.29",
    "@portal/config": "workspace:*",
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.0",
    "@types/web-push": "^3.6.4",
    "cross-env": "^10.1.0",
    "dbmate": "^2.33.0",
    "dependency-cruiser": "^18.1.1",
    "eslint": "9.39.4",
    "eslint-plugin-boundaries": "^7.1.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  }
}
