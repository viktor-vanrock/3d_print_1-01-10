{
  "name": "@portal/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && tsc -p tsconfig.sw.json && vite build",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.sw.json && tsc -p tsconfig.tools.json",
    "api:types:generate": "openapi-typescript ../../packages/contracts/http/openapi.v1.json --output src/api/generated/openapi.ts --immutable --alphabetize --empty-objects-unknown",
    "api:types:check": "openapi-typescript ../../packages/contracts/http/openapi.v1.json --output src/api/generated/openapi.ts --immutable --alphabetize --empty-objects-unknown --check",
    "lint": "eslint .",
    "test": "vitest run && node scripts/a11ycheck.mjs",
    "test:e2e": "playwright test",
    "a11ycheck": "node scripts/a11ycheck.mjs",
    "icons:generate": "node scripts/generateicons.mjs",
    "pwa:audit": "node scripts/pwaaudit.mjs"
  },
  "dependencies": {
    "@portal/contracts": "workspace:*",
    "dompurify": "^3.4.13",
    "marked": "^18.0.5",
    "mermaid": "^11.16.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@portal/config": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "happy-dom": "^20.8.8",
    "jsdom": "^29.1.1",
    "openapi-typescript": "7.13.0",
    "sharp": "^0.35.4",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.6",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
