# Образ apps/scout по умолчанию запускает `scout-worker`: раз в заданный интервал он
# обходит источники станков/филаментов и пишет кандидатов и релизы в PostgreSQL.
# Дополнительные команды образа запускают разовые агенты профилей, resolver и news-контур.

# Обязательно для всех агентов, которые читают или записывают данные портала.
# Без DATABASE_URL основной воркер не падает, но простаивает.
DATABASE_URL=postgresql://portal:<пароль>@postgres:5432/portal

# Интервал полного обхода источников основным scout-worker, в секундах.
SCOUT_POLL_INTERVAL_SECONDS=3600

# Опциональный GitHub token для агентов профилей слайсеров и Spoolman.
# Без токена используются низкие анонимные лимиты GitHub API.
GITHUB_TOKEN=

# --- News-контур, используется только командами scout-news-* ---

# Фильтр брендов через запятую. Пусто — обрабатывать все поддерживаемые бренды.
SCOUT_NEWS_BRAND_FILTER=

# OpenAI-совместимые адреса и имена моделей. Для news-worker заполните все четыре значения
# явно: пустая переменная отменяет исторический дефолт из кода и не является рабочим адресом.
SCOUT_NEWS_RESEARCHER_URL=
SCOUT_NEWS_RESEARCHER_MODEL=
SCOUT_NEWS_COMPOSER_URL=
SCOUT_NEWS_COMPOSER_MODEL=
SCOUT_NEWS_COMPOSER_THINKING=true

# Локальный CLI Grok для дополнительного этапа news pipeline.
SCOUT_NEWS_GROK_EXECUTABLE=grok
SCOUT_NEWS_GROK_MODEL=grok-4.5
SCOUT_NEWS_GROK_MODEL_VERSION=grok-4.5

# Публикация подготовленных новостей в API портала.
SCOUT_NEWS_FEED_API_BASE_URL=https://api.example.ru
SCOUT_NEWS_PUBLIC_BASE_URL=https://portal.example.ru
SCOUT_NEWS_ATTEMPT=1
SCOUT_NEWS_FEED_INGEST_KEY=

# CREDENTIALS_DIRECTORY обычно задаёт systemd при подключении LoadCredential.
# В Docker безопаснее передать SCOUT_NEWS_FEED_INGEST_KEY через secret, а не задавать этот путь.
CREDENTIALS_DIRECTORY=
